<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_KarstHills</defName>
		<label>karst hills</label>
		<description>Pale limestone spires and sinkholes swallowed by hot jungle, with hidden caves beneath everything. Stone is abundant and the caves give natural cover, but the broken terrain fights every step and disease is rife.</description>
		<texture>World/Biomes/ZBiome_CloudForest</texture>
		<workerClass>MoreVanillaBiomesExpansion.BiomeWorker_Parametric</workerClass>
		<settlementSelectionWeight>0.4</settlementSelectionWeight>
		<movementDifficulty>1.7</movementDifficulty>
		<wildPlantsCareAboutLocalFertility>true</wildPlantsCareAboutLocalFertility>
		<animalDensity>2.6</animalDensity>
		<plantDensity>0.9</plantDensity>
		<wildPlantRegrowDays>16</wildPlantRegrowDays>
		<forageability>0.7</forageability>
		<foragedFood>RawBerries</foragedFood>
		<lakeBeachTerrain>Mud</lakeBeachTerrain>
		<riverbankTerrain>Riverbank</riverbankTerrain>
		<riverbankSizeRange>6~8</riverbankSizeRange>
		<maxFishPopulation>720</maxFishPopulation>
		<fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
			<freshwater_Common><Fish_Tilapia MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Tilapia></freshwater_Common>
			<freshwater_Uncommon><Fish_Piranha MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Piranha></freshwater_Uncommon>
			<saltwater_Common><Fish_Bluefish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Bluefish></saltwater_Common>
			<saltwater_Uncommon><Fish_Flounder MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Flounder></saltwater_Uncommon>
			<rareCatchesSetMaker MayRequire="Ludeon.RimWorld.Odyssey">RareFishingCatches_Tropical</rareCatchesSetMaker>
		</fishTypes>
		<soundsAmbient>
			<li>Ambient_NightInsects_Standard</li>
		</soundsAmbient>
		<diseaseMtbDays>45</diseaseMtbDays>
		<diseases>
			<li><diseaseInc>Disease_Flu</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_Plague</diseaseInc><commonality>80</commonality></li>
			<li><diseaseInc>Disease_Malaria</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_FibrousMechanites</diseaseInc><commonality>40</commonality></li>
			<li><diseaseInc>Disease_SensoryMechanites</diseaseInc><commonality>40</commonality></li>
			<li><diseaseInc>Disease_GutWorms</diseaseInc><commonality>30</commonality></li>
			<li><diseaseInc>Disease_MuscleParasites</diseaseInc><commonality>30</commonality></li>
			<li><diseaseInc>Disease_AnimalFlu</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_AnimalPlague</diseaseInc><commonality>80</commonality></li>
		</diseases>
		<terrainsByFertility>
			<li><terrain>Sand</terrain><min>-999</min><max>0.3</max></li>
			<li><terrain>Gravel</terrain><min>0.3</min><max>0.6</max></li>
			<li><terrain>Sandstone_Rough</terrain><min>0.6</min><max>0.85</max></li>
			<li><terrain>Soil</terrain><min>0.85</min><max>999</max></li>
		</terrainsByFertility>
		<terrainPatchMakers>
			<li>
				<perlinFrequency>0.045</perlinFrequency>
				<perlinLacunarity>1.8</perlinLacunarity>
				<thresholds>
					<li><terrain>Sandstone_Rough</terrain><min>-999</min><max>-0.15</max></li>
