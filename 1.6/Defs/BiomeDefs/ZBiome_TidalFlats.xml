			<Plant_Chokevine>0.8</Plant_Chokevine>
			<Plant_Dandelion>0.3</Plant_Dandelion>
			<Plant_Berry>0.05</Plant_Berry>
			<Plant_Reeds MayRequire="Ludeon.RimWorld.Odyssey">2.0</Plant_Reeds>
			<Plant_Bulrush MayRequire="Ludeon.RimWorld.Odyssey">0.6</Plant_Bulrush>
			<Plant_LilyPad MayRequire="Ludeon.RimWorld.Odyssey">0.2</Plant_LilyPad>
		</wildPlants>
		<wildAnimals>
			<Duck>0.8</Duck>
			<Hare>0.7</Hare>
			<Rat>1.0</Rat>
			<Capybara>0.4</Capybara>
			<Deer>0.3</Deer>
			<Fox_Red>0.1</Fox_Red>
			<Wolf_Timber>0.05</Wolf_Timber>
			<Swan MayRequire="Ludeon.RimWorld.Odyssey">0.3</Swan>
			<Flamingo MayRequire="Ludeon.RimWorld.Odyssey">0.3</Flamingo>
			<Mink MayRequire="Ludeon.RimWorld.Odyssey">0.25</Mink>
			<Bullfrog MayRequire="Ludeon.RimWorld.Odyssey">0.3</Bullfrog>
			<Crow MayRequire="Ludeon.RimWorld.Odyssey">0.4</Crow>
		</wildAnimals>
		<coastalWildAnimals>
			<Seal MayRequire="Ludeon.RimWorld.Odyssey">0.2</Seal>
			<HermitCrab MayRequire="Ludeon.RimWorld.Odyssey">0.3</HermitCrab>
			<StoneCrab MayRequire="Ludeon.RimWorld.Odyssey">0.3</StoneCrab>
			<SeaTurtle MayRequire="Ludeon.RimWorld.Odyssey">0.1</SeaTurtle>
			<Otter MayRequire="Ludeon.RimWorld.Odyssey">0.15</Otter>
		</coastalWildAnimals>
		<allowedPackAnimals>
			<li>Muffalo</li>
			<li>Alpaca</li>
		</allowedPackAnimals>
		<modExtensions>
			<li Class="MoreVanillaBiomesExpansion.BiomeExtension">
				<minTemp>4</minTemp>
				<maxTemp>20</maxTemp>
				<minRainfall>680</minRainfall>
				<maxRainfall>1650</maxRainfall>
				<maxElevation>200</maxElevation>
				<minHilliness>1</minHilliness>
				<maxHilliness>1</maxHilliness>
				<score>11</score>
				<elevWeight>-0.12</elevWeight>
				<elevPivot>210</elevPivot>
			</li>
		</modExtensions>
	</BiomeDef>

</Defs>
