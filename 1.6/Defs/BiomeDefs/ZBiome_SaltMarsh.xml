<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_SaltMarsh</defName>
		<label>salt marsh</label>
		<description>Flat tidal grass where a river meets the sea, threaded with brackish creeks and reed beds and loud with waterfowl. The reeds and decent soil support life, but flooding is common and trees are scarce.</description>
