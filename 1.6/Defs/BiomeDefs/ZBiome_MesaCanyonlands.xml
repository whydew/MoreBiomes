<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_MesaCanyonlands</defName>
		<label>mesa canyonlands</label>
		<description>Red-rock plateaus split by shaded slot canyons, layered sandstone glowing at dusk. Dry and stony, but the broken ground is highly defensible and rich in stone.</description>
