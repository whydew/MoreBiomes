			<Muffalo>0.6</Muffalo>
			<Gazelle>0.5</Gazelle>
			<Elephant>0.4</Elephant>
			<Rhinoceros>0.3</Rhinoceros>
			<WildBoar>0.5</WildBoar>
			<Cassowary>0.5</Cassowary>
			<Iguana>0.4</Iguana>
			<Cougar>0.12</Cougar>
			<Panther>0.1</Panther>
			<Rat>1.0</Rat>
			<Hippo MayRequire="Ludeon.RimWorld.Odyssey">0.25</Hippo>
			<Flamingo MayRequire="Ludeon.RimWorld.Odyssey">0.5</Flamingo>
			<MonitorLizard MayRequire="Ludeon.RimWorld.Odyssey">0.4</MonitorLizard>
