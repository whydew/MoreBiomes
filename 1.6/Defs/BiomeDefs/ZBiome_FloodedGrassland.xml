			<li Class="MoreVanillaBiomesExpansion.BiomeExtension">
				<minTemp>16</minTemp>
				<maxTemp>32</maxTemp>
				<minRainfall>1150</minRainfall>
				<maxRainfall>2600</maxRainfall>
				<minHilliness>1</minHilliness>
				<maxHilliness>2</maxHilliness>
				<score>15</score>
				<flatBonus>1.5</flatBonus>
			</li>
