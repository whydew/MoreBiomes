<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_AlpineFell</defName>
		<label>alpine fell</label>
		<description>Bare rock and scree above the treeline, with cushion plants clinging in the cracks and a thin, cold wind. Cold and near-infertile, but defensible on the heights and heavy with stone and minerals.</description>
