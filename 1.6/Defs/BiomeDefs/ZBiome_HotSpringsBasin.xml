<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_HotSpringsBasin</defName>
		<label>hot springs basin</label>
		<description>A sheltered valley of steaming pools and mineral terraces tucked into frozen highland, an unlikely warm refuge. Free heat and a long growing season in the cold, but the arable footprint is tiny and the water reeks of sulfur.</description>
		<texture>World/Biomes/ZBiome_CloudForest</texture>
		<workerClass>MoreVanillaBiomesExpansion.BiomeWorker_Parametric</workerClass>
		<settlementSelectionWeight>0.55</settlementSelectionWeight>
		<movementDifficulty>1.4</movementDifficulty>
		<wildPlantsCareAboutLocalFertility>true</wildPlantsCareAboutLocalFertility>
		<animalDensity>2.4</animalDensity>
		<plantDensity>0.9</plantDensity>
		<wildPlantRegrowDays>15</wildPlantRegrowDays>
		<forageability>0.7</forageability>
		<foragedFood>RawBerries</foragedFood>
		<lakeBeachTerrain>Mud</lakeBeachTerrain>
		<riverbankTerrain>Riverbank</riverbankTerrain>
		<riverbankSizeRange>6~8</riverbankSizeRange>
		<maxFishPopulation>620</maxFishPopulation>
