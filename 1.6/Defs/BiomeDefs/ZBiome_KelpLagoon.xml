<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_KelpLagoon</defName>
		<label>kelp lagoon</label>
		<description>Warm turquoise shallows over a living reef and kelp, bright and teeming with life. Fishing is superb and a few reef shoals give solid footing, but buildable ground stays scarce.</description>
		<texture>World/Biomes/ZBiome_Sandbar</texture>
		<workerClass>MoreVanillaBiomesExpansion.BiomeWorker_Parametric</workerClass>
		<settlementSelectionWeight>0.1</settlementSelectionWeight>
		<movementDifficulty>1.5</movementDifficulty>
		<animalDensity>1.2</animalDensity>
		<plantDensity>0.5</plantDensity>
		<wildPlantRegrowDays>22</wildPlantRegrowDays>
		<forageability>0.35</forageability>
		<foragedFood>RawBerries</foragedFood>
		<lakeBeachTerrain>Sand</lakeBeachTerrain>
		<coastalBeachTerrain>Sand</coastalBeachTerrain>
		<riverbankTerrain>Sand</riverbankTerrain>
		<canAutoChoose>false</canAutoChoose>
		<allowRoads>false</allowRoads>
		<allowRivers>false</allowRivers>
		<preventGenSteps><li>ScatterShrines</li></preventGenSteps>
		<maxFishPopulation>900</maxFishPopulation>
		<fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
			<freshwater_Common><Fish_Tilapia MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Tilapia></freshwater_Common>
			<freshwater_Uncommon><Fish_Piranha MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Piranha></freshwater_Uncommon>
			<saltwater_Common><Fish_Bluefish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Bluefish></saltwater_Common>
			<saltwater_Uncommon><Fish_Flounder MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Flounder></saltwater_Uncommon>
			<rareCatchesSetMaker MayRequire="Ludeon.RimWorld.Odyssey">RareFishingCatches_Tropical</rareCatchesSetMaker>
		</fishTypes>
		<soundsAmbient>
			<li>Ambient_NightInsects_Standard</li>
		</soundsAmbient>
		<diseaseMtbDays>45</diseaseMtbDays>
		<diseases>
			<li><diseaseInc>Disease_Flu</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_Plague</diseaseInc><commonality>80</commonality></li>
			<li><diseaseInc>Disease_Malaria</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_FibrousMechanites</diseaseInc><commonality>40</commonality></li>
			<li><diseaseInc>Disease_SensoryMechanites</diseaseInc><commonality>40</commonality></li>
			<li><diseaseInc>Disease_GutWorms</diseaseInc><commonality>30</commonality></li>
			<li><diseaseInc>Disease_MuscleParasites</diseaseInc><commonality>30</commonality></li>
			<li><diseaseInc>Disease_AnimalFlu</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_AnimalPlague</diseaseInc><commonality>80</commonality></li>
		</diseases>
		<terrainsByFertility>
			<li><terrain>WaterOceanDeep</terrain><min>-999</min><max>0.35</max></li>
			<li><terrain>WaterOceanShallow</terrain><min>0.35</min><max>0.75</max></li>
			<li><terrain>Sand</terrain><min>0.75</min><max>0.95</max></li>
			<li><terrain>SoftSand</terrain><min>0.95</min><max>999</max></li>
		</terrainsByFertility>
		<baseWeatherCommonalities>
			<Clear>16</Clear>
			<Fog>2</Fog>
			<Rain>2</Rain>
			<DryThunderstorm>1</DryThunderstorm>
			<RainyThunderstorm>1.5</RainyThunderstorm>
			<FoggyRain>1.5</FoggyRain>
			<SnowGentle>3</SnowGentle>
			<SnowHard>3</SnowHard>
			<GrayPall MayRequire="Ludeon.RimWorld.Anomaly">1</GrayPall>
			<Windy MayRequire="Ludeon.RimWorld.Odyssey">1</Windy>
			<Overcast MayRequire="Ludeon.RimWorld.Odyssey">1</Overcast>
			<TorrentialRain MayRequire="Ludeon.RimWorld.Odyssey">0.5</TorrentialRain>
		</baseWeatherCommonalities>
		<wildPlants>
			<Plant_Bush>0.4</Plant_Bush>
			<Plant_Grass>0.6</Plant_Grass>
			<Plant_Reeds MayRequire="Ludeon.RimWorld.Odyssey">1.0</Plant_Reeds>
			<Plant_LilyPad MayRequire="Ludeon.RimWorld.Odyssey">0.3</Plant_LilyPad>
			<Plant_Bulrush MayRequire="Ludeon.RimWorld.Odyssey">0.2</Plant_Bulrush>
		</wildPlants>
		<wildAnimals>
			<Rat>0.4</Rat>
			<Iguana>0.3</Iguana>
			<Cassowary>0.2</Cassowary>
			<Tortoise>0.3</Tortoise>
			<Flamingo MayRequire="Ludeon.RimWorld.Odyssey">0.4</Flamingo>
			<Macaw MayRequire="Ludeon.RimWorld.Odyssey">0.2</Macaw>
		</wildAnimals>
		<coastalWildAnimals>
			<Seal MayRequire="Ludeon.RimWorld.Odyssey">0.5</Seal>
			<SeaLion MayRequire="Ludeon.RimWorld.Odyssey">0.4</SeaLion>
			<SeaTurtle MayRequire="Ludeon.RimWorld.Odyssey">0.4</SeaTurtle>
			<HermitCrab MayRequire="Ludeon.RimWorld.Odyssey">0.4</HermitCrab>
			<StoneCrab MayRequire="Ludeon.RimWorld.Odyssey">0.4</StoneCrab>
			<Otter MayRequire="Ludeon.RimWorld.Odyssey">0.3</Otter>
		</coastalWildAnimals>
		<allowedPackAnimals>
			<li>Muffalo</li>
		</allowedPackAnimals>
		<modExtensions>
			<li Class="MoreVanillaBiomesExpansion.BiomeExtension">
				<needsWater>true</needsWater>
				<minTemp>8</minTemp>
				<maxTemp>60</maxTemp>
				<minElevation>-70</minElevation>
				<maxElevation>0</maxElevation>
				<minHilliness>0</minHilliness>
				<maxHilliness>5</maxHilliness>
				<rejectChance>0.55</rejectChance>
				<score>18</score>
			</li>
		</modExtensions>
	</BiomeDef>

</Defs>
