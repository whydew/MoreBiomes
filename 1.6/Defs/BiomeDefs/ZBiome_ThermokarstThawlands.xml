<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_ThermokarstThawlands</defName>
		<label>thermokarst thawlands</label>
		<description>A pockmarked northern flat of thaw lakes and heaving permafrost. It is iron-hard and buildable through the long winter, then dissolves into a meltwater maze teeming with fish and waterfowl in the brief summer thaw.</description>
		<texture>World/Biomes/ZBiome_GlacialShield</texture>
		<workerClass>MoreVanillaBiomesExpansion.BiomeWorker_Parametric</workerClass>
		<settlementSelectionWeight>0.35</settlementSelectionWeight>
		<movementDifficulty>1.8</movementDifficulty>
		<wildPlantsCareAboutLocalFertility>true</wildPlantsCareAboutLocalFertility>
		<animalDensity>2.4</animalDensity>
		<plantDensity>0.7</plantDensity>
		<wildPlantRegrowDays>20</wildPlantRegrowDays>
		<forageability>0.35</forageability>
		<foragedFood>RawBerries</foragedFood>
		<lakeBeachTerrain>Mud</lakeBeachTerrain>
		<coastalBeachTerrain>Mud</coastalBeachTerrain>
		<riverbankTerrain>Riverbank</riverbankTerrain>
		<riverbankSizeRange>5~9</riverbankSizeRange>
		<maxFishPopulation>620</maxFishPopulation>
