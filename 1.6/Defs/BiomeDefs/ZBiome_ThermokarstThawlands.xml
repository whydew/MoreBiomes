			<li><diseaseInc>Disease_AnimalPlague</diseaseInc><commonality>80</commonality></li>
		</diseases>
		<terrainsByFertility>
			<li><terrain>WaterDeep</terrain><min>-999</min><max>0.06</max></li>
			<li><terrain>WaterShallow</terrain><min>0.06</min><max>0.2</max></li>
			<li><terrain>Mud</terrain><min>0.2</min><max>0.27</max></li>
