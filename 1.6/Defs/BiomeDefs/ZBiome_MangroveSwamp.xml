<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_MangroveSwamp</defName>
		<label>mangrove swamp</label>
		<description>A hot, brackish maze of stilt-rooted trees and tidal channels, buzzing and waterlogged. The tidal shallows are a rich fish-and-shellfish nursery, but disease is rife and the shifting water carves up any solid ground.</description>
		<texture>World/Biomes/ZBiome_Marsh</texture>
		<workerClass>MoreVanillaBiomesExpansion.BiomeWorker_Parametric</workerClass>
		<settlementSelectionWeight>0.35</settlementSelectionWeight>
		<movementDifficulty>2.6</movementDifficulty>
		<animalDensity>3.0</animalDensity>
		<plantDensity>0.98</plantDensity>
		<wildPlantRegrowDays>15</wildPlantRegrowDays>
		<forageability>0.6</forageability>
		<foragedFood>RawBerries</foragedFood>
		<lakeBeachTerrain>Mud</lakeBeachTerrain>
		<coastalBeachTerrain>Mud</coastalBeachTerrain>
		<riverbankTerrain>Mud</riverbankTerrain>
		<riverbankSizeRange>6~9</riverbankSizeRange>
		<maxFishPopulation>760</maxFishPopulation>
		<fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
			<freshwater_Common><Fish_Tilapia MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Tilapia></freshwater_Common>
			<freshwater_Uncommon><Fish_Piranha MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Piranha></freshwater_Uncommon>
			<saltwater_Common><Fish_Bluefish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Bluefish></saltwater_Common>
			<saltwater_Uncommon><Fish_Flounder MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Flounder></saltwater_Uncommon>
			<rareCatchesSetMaker MayRequire="Ludeon.RimWorld.Odyssey">RareFishingCatches_Tropical</rareCatchesSetMaker>
		</fishTypes>
		<soundsAmbient>
			<li>Ambient_NightInsects_Standard</li>
		</soundsAmbient>
		<diseaseMtbDays>45</diseaseMtbDays>
		<diseases>
			<li><diseaseInc>Disease_Flu</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_Plague</diseaseInc><commonality>80</commonality></li>
			<li><diseaseInc>Disease_Malaria</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_FibrousMechanites</diseaseInc><commonality>40</commonality></li>
			<li><diseaseInc>Disease_SensoryMechanites</diseaseInc><commonality>40</commonality></li>
			<li><diseaseInc>Disease_GutWorms</diseaseInc><commonality>30</commonality></li>
			<li><diseaseInc>Disease_MuscleParasites</diseaseInc><commonality>30</commonality></li>
			<li><diseaseInc>Disease_AnimalFlu</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_AnimalPlague</diseaseInc><commonality>80</commonality></li>
		</diseases>
		<terrainsByFertility>
			<li><terrain>WaterOceanDeep</terrain><min>-999</min><max>0.1</max></li>
			<li><terrain>WaterOceanShallow</terrain><min>0.1</min><max>0.3</max></li>
			<li><terrain>Mud</terrain><min>0.3</min><max>0.45</max></li>
			<li><terrain>Sand</terrain><min>0.45</min><max>0.6</max></li>
			<li><terrain>Soil</terrain><min>0.6</min><max>0.92</max></li>
			<li><terrain>SoilRich</terrain><min>0.92</min><max>999</max></li>
		</terrainsByFertility>
		<terrainPatchMakers>
			<li>
				<perlinFrequency>0.015</perlinFrequency>
				<thresholds>
					<li><terrain>SoilRich</terrain><min>0.71</min><max>0.80</max></li>
					<li><terrain>Mud</terrain><min>0.80</min><max>0.93</max></li>
					<li><terrain>WaterShallow</terrain><min>0.93</min><max>1.06</max></li>
					<li><terrain>WaterDeep</terrain><min>1.06</min><max>999</max></li>
				</thresholds>
			</li>
		</terrainPatchMakers>
