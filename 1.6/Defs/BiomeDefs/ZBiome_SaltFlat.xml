			<saltwater_Common><Fish_Bluefish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Bluefish></saltwater_Common>
			<saltwater_Uncommon><Fish_Tuna MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Tuna></saltwater_Uncommon>
			<rareCatchesSetMaker MayRequire="Ludeon.RimWorld.Odyssey">RareFishingCatches_Hot</rareCatchesSetMaker>
		</fishTypes>
		<soundsAmbient>
			<li>Ambient_Wind_Desolate</li>
		</soundsAmbient>
		<diseaseMtbDays>90</diseaseMtbDays>
		<diseases>
			<li><diseaseInc>Disease_Flu</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_Plague</diseaseInc><commonality>80</commonality></li>
			<li><diseaseInc>Disease_GutWorms</diseaseInc><commonality>40</commonality></li>
