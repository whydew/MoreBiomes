<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_SaltFlat</defName>
		<label>salt flat</label>
		<description>A blinding, cracked mineral crust stretching to the horizon, hard as tile and nearly lifeless. Nothing grows and little moves, but the ground is dead flat and rich in minerals.</description>
		<texture>World/Biomes/ZBiome_Oasis</texture>
		<workerClass>MoreVanillaBiomesExpansion.BiomeWorker_Parametric</workerClass>
		<settlementSelectionWeight>0.15</settlementSelectionWeight>
		<movementDifficulty>1.1</movementDifficulty>
		<animalDensity>0.35</animalDensity>
		<plantDensity>0.15</plantDensity>
		<wildPlantRegrowDays>35</wildPlantRegrowDays>
		<forageability>0.1</forageability>
		<foragedFood>RawAgave</foragedFood>
		<lakeBeachTerrain>Sand</lakeBeachTerrain>
		<riverbankTerrain>Sand</riverbankTerrain>
		<isExtremeBiome>true</isExtremeBiome>
		<maxFishPopulation>300</maxFishPopulation>
		<fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
