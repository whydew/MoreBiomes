<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_ColdSteppe</defName>
		<label>cold steppe</label>
		<description>A cool, semi-dry shortgrass prairie combed flat by the wind. Migrating herds sweep through to graze and move on, and a brief growing season is bracketed by hard frosts. There is no natural cover on the open ground.</description>
		<texture>World/Biomes/ZBiome_Grasslands</texture>
		<workerClass>MoreVanillaBiomesExpansion.BiomeWorker_Parametric</workerClass>
		<settlementSelectionWeight>0.7</settlementSelectionWeight>
		<movementDifficulty>1</movementDifficulty>
		<animalDensity>2.2</animalDensity>
		<plantDensity>0.75</plantDensity>
		<wildPlantRegrowDays>26</wildPlantRegrowDays>
		<forageability>0.6</forageability>
		<foragedFood>RawBerries</foragedFood>
		<lakeBeachTerrain>Mud</lakeBeachTerrain>
		<riverbankTerrain>Riverbank</riverbankTerrain>
		<riverbankSizeRange>6~8</riverbankSizeRange>
		<maxFishPopulation>480</maxFishPopulation>
		<fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
			<freshwater_Common><Fish_Salmon MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Salmon></freshwater_Common>
			<freshwater_Uncommon><Fish_Frostfish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Frostfish></freshwater_Uncommon>
			<saltwater_Common><Fish_Cod MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Cod></saltwater_Common>
			<saltwater_Uncommon><Fish_Dogfish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Dogfish></saltwater_Uncommon>
			<rareCatchesSetMaker MayRequire="Ludeon.RimWorld.Odyssey">RareFishingCatches_Cold</rareCatchesSetMaker>
		</fishTypes>
		<soundsAmbient>
			<li>Ambient_NightInsects_Standard</li>
