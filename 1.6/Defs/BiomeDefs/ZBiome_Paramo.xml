			<li><terrain>SoilRich</terrain><min>0.73</min><max>999</max></li>
		</terrainsByFertility>
		<terrainPatchMakers>
			<li>
				<perlinFrequency>0.015</perlinFrequency>
				<thresholds>
					<li><terrain>SoilRich</terrain><min>0.71</min><max>0.80</max></li>
					<li><terrain>Mud</terrain><min>0.80</min><max>0.93</max></li>
					<li><terrain>WaterShallow</terrain><min>0.93</min><max>1.06</max></li>
