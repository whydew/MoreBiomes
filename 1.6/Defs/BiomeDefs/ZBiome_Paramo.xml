<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_Paramo</defName>
		<label>paramo</label>
		<description>Misty, spongy tussock grassland high above the treeline, dotted with giant rosette plants in the fog. Water-rich and defensible on the heights, but cold, treeless and hard to build on.</description>
		<texture>World/Biomes/ZBiome_AlpineMeadow</texture>
		<workerClass>MoreVanillaBiomesExpansion.BiomeWorker_Parametric</workerClass>
		<settlementSelectionWeight>0.35</settlementSelectionWeight>
		<movementDifficulty>1.5</movementDifficulty>
		<wildPlantsCareAboutLocalFertility>true</wildPlantsCareAboutLocalFertility>
		<animalDensity>1.8</animalDensity>
		<plantDensity>0.8</plantDensity>
		<wildPlantRegrowDays>20</wildPlantRegrowDays>
		<forageability>0.4</forageability>
		<foragedFood>RawBerries</foragedFood>
		<lakeBeachTerrain>Mud</lakeBeachTerrain>
		<riverbankTerrain>Riverbank</riverbankTerrain>
		<riverbankSizeRange>6~8</riverbankSizeRange>
		<maxFishPopulation>560</maxFishPopulation>
