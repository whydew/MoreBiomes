<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<BiomeDef>
		<defName>ZBiome_RedwoodCoast</defName>
		<label>redwood coast</label>
		<description>Cool temperate rainforest of impossibly tall conifers over a fern floor, in permanent drip and green gloom. The giant trees hold vast amounts of wood, but the damp breeds disease and little sunlight reaches the ground.</description>
		<texture>World/Biomes/ZBiome_CloudForest</texture>
		<workerClass>MoreVanillaBiomesExpansion.BiomeWorker_Parametric</workerClass>
		<settlementSelectionWeight>0.6</settlementSelectionWeight>
		<movementDifficulty>1.5</movementDifficulty>
		<wildPlantsCareAboutLocalFertility>true</wildPlantsCareAboutLocalFertility>
		<animalDensity>2.5</animalDensity>
		<plantDensity>0.95</plantDensity>
		<wildPlantRegrowDays>16</wildPlantRegrowDays>
		<forageability>0.9</forageability>
		<foragedFood>RawBerries</foragedFood>
		<lakeBeachTerrain>Mud</lakeBeachTerrain>
		<riverbankTerrain>Riverbank</riverbankTerrain>
		<riverbankSizeRange>6~8</riverbankSizeRange>
		<maxFishPopulation>700</maxFishPopulation>
		<fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
			<freshwater_Common><Fish_Salmon MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Salmon></freshwater_Common>
			<freshwater_Uncommon><Fish_Frostfish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Frostfish></freshwater_Uncommon>
			<saltwater_Common><Fish_Cod MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Cod></saltwater_Common>
			<saltwater_Uncommon><Fish_Dogfish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Dogfish></saltwater_Uncommon>
			<rareCatchesSetMaker MayRequire="Ludeon.RimWorld.Odyssey">RareFishingCatches_Cold</rareCatchesSetMaker>
		</fishTypes>
		<soundsAmbient>
			<li>Ambient_NightInsects_Standard</li>
		</soundsAmbient>
		<diseaseMtbDays>45</diseaseMtbDays>
		<diseases>
			<li><diseaseInc>Disease_Flu</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_Plague</diseaseInc><commonality>80</commonality></li>
			<li><diseaseInc>Disease_Malaria</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_FibrousMechanites</diseaseInc><commonality>40</commonality></li>
			<li><diseaseInc>Disease_SensoryMechanites</diseaseInc><commonality>40</commonality></li>
			<li><diseaseInc>Disease_GutWorms</diseaseInc><commonality>30</commonality></li>
			<li><diseaseInc>Disease_MuscleParasites</diseaseInc><commonality>30</commonality></li>
			<li><diseaseInc>Disease_AnimalFlu</diseaseInc><commonality>100</commonality></li>
			<li><diseaseInc>Disease_AnimalPlague</diseaseInc><commonality>80</commonality></li>
		</diseases>
		<terrainsByFertility>
			<li><terrain>Soil</terrain><min>-999</min><max>0.73</max></li>
			<li><terrain>SoilRich</terrain><min>0.73</min><max>999</max></li>
		</terrainsByFertility>
		<terrainPatchMakers>
			<li>
				<perlinFrequency>0.015</perlinFrequency>
				<thresholds>
					<li><terrain>SoilRich</terrain><min>0.71</min><max>0.80</max></li>
					<li><terrain>Mud</terrain><min>0.80</min><max>0.93</max></li>
					<li><terrain>WaterShallow</terrain><min>0.93</min><max>1.06</max></li>
					<li><terrain>WaterDeep</terrain><min>1.06</min><max>999</max></li>
				</thresholds>
			</li>
		</terrainPatchMakers>
		<baseWeatherCommonalities>
			<Clear>6</Clear>
			<Fog>10</Fog>
			<Rain>2</Rain>
			<DryThunderstorm>1</DryThunderstorm>
